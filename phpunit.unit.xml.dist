<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/9.6/phpunit.xsd"
         bootstrap=".github/ci/unit-bootstrap.php"
         cacheResult="false"
         colors="true">
    <php>
        <env name="PLUGIN_FOLDER" value="BeplyPluginTemplate"/>
    </php>
    <testsuites>
        <testsuite name="unit">
            <directory suffix="Test.php">Test</directory>
            <exclude>Test/main</exclude>
        </testsuite>
    </testsuites>
</phpunit>

